{
  "id": "full_body_athlete",
  "name": "Full body — athlete",
  "description": "EXOS-lite + Athlean: prep, optional power, strength primaries, unilateral, carry/corrective, optional conditioning.",
  "estimated_minutes_base": 55,
  "blocks": [
    {
      "type": "prep",
      "label": "Prep",
      "minutes": 8,
      "slots": [
        { "id": "prep_mobility", "patterns": ["corrective"], "intents": ["mobility"], "count": 1 },
        { "id": "prep_activation", "patterns": ["corrective", "rotate"], "intents": ["stability"], "count": 1, "core_roles": ["anti_extension", "anti_rotation", "anti_lateral_flexion"] }
      ]
    },
    {
      "type": "power",
      "label": "Power",
      "optional": true,
      "requires_flag": "include_power",
      "min_minutes": 45,
      "slots": [
        { "id": "power", "patterns": ["hinge", "locomotion", "rotate"], "intents": ["power"], "require_intents": ["power"], "prefer_family": "hinge_power", "count": 1 }
      ]
    },
    {
      "type": "strength",
      "label": "Strength primary A",
      "slots": [
        { "id": "primary_hinge", "patterns": ["hinge"], "intents": ["strength", "hypertrophy"], "prefer_family": "hinge_strength" }
      ]
    },
    {
      "type": "strength",
      "label": "Strength primary B",
      "slots": [
        { "id": "primary_push", "patterns": ["push_horizontal", "push_vertical"], "intents": ["strength", "hypertrophy"] }
      ]
    },
    {
      "type": "accessory",
      "label": "Unilateral / squat pattern",
      "slots": [
        { "id": "unilateral", "patterns": ["lunge", "squat"], "intents": ["strength", "hypertrophy"], "prefer_patterns": ["lunge"] }
      ]
    },
    {
      "type": "accessory",
      "label": "Pull",
      "slots": [
        { "id": "pull", "patterns": ["pull_horizontal", "pull_vertical"], "intents": ["strength", "hypertrophy"] }
      ]
    },
    {
      "type": "carry",
      "label": "Carry",
      "slots": [
        { "id": "carry", "patterns": ["carry"], "intents": ["strength", "stability", "conditioning"] }
      ]
    },
    {
      "type": "corrective",
      "label": "Corrective finish",
      "slots": [
        { "id": "finish_corrective", "patterns": ["corrective", "rotate"], "intents": ["stability"], "core_roles": ["anti_extension", "anti_rotation", "anti_lateral_flexion"] }
      ]
    },
    {
      "type": "conditioning",
      "label": "Conditioning",
      "optional": true,
      "requires_flag": "include_conditioning",
      "min_minutes": 60,
      "slots": [
        { "id": "conditioning", "patterns": ["locomotion", "hinge", "carry"], "intents": ["conditioning", "power"], "count": 1 }
      ]
    }
  ],
  "coverage": {
    "require_any": [
      ["hinge"],
      ["squat", "lunge"],
      ["push_horizontal", "push_vertical"],
      ["pull_horizontal", "pull_vertical"],
      ["carry", "rotate", "corrective"]
    ]
  }
}
